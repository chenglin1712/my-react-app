# ============================================================
# 環境變數範本 — 複製此檔案並改名為 .env，填入真實值後才能啟動
# ============================================================

# ── Firebase（Firebase Console → 專案設定 → 你的應用程式）──────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── 音檔 API（族語資料庫音檔來源，通常不需更改）──────────────
VITE_AUDIO_FILE_URL=https://e-dictionary.ilrdf.org.tw/api/app/file/download-file/

# ── 詞彙搜尋 API（FastAPI port 8001）────────────────────────
VITE_API_SEARCH_ALL_URL=/api/v1/dictionary/all/
VITE_API_SEARCH_KEY_URL=/api/v1/dictionary/key/
VITE_API_SEARCH_KEYS_URL=/api/v1/dictionary/keys/
VITE_API_SEARCH_AUDIO_URL=/api/v1/dictionary/audio/
VITE_API_SENTENCE_AUDIO_URL=/api/v1/dictionary/sentence-audio/

# ── 聽力／句型遊戲 API（FastAPI port 8001）───────────────────
VITE_API_LISTENING_QUESTIONS_URL=/api/v1/listening/questions
VITE_API_SENTENCE_QUESTIONS_URL=/api/v1/sentence/questions

# ── 測驗 API（Django port 8000）──────────────────────────────
VITE_API_QUIZ_URL=/crawler/
VITE_API_QUIZ_AUDIO_URL=/api/v1/quiz/compare_audio/

# ── 薦讀測驗 IRT API（FastAPI port 8001）────────────────────
VITE_API_GENERATE_QUIZ_URL=/api/v1/quiz/generate_quiz_frontend
VITE_API_SUBMIT_QUIZ_ANSWER_URL=/api/v1/quiz/submit_answer_frontend

# ── 首頁新聞 API（Django port 8000）──────────────────────────
VITE_API_NEWS_URL=/crawler/news/

# ── 族語認證考試時程 API（Django port 8000，爬官網日程表）──────
VITE_API_EXAM_SCHEDULE_URL=/crawler/exam_schedule/

# ── AI 助手 API（Django AIModel port 8000）───────────────────
VITE_API_AI_BOT_URL=/AIModel/tayal_chat/
VITE_API_REVIEW_BOT_URL=/AIModel/review_tayal_chat/

# ── 影像辨識 API（FastAPI port 8001）────────────────────────
VITE_API_VISION_URL=/api/v1/vision/analyze_image/

# ── Google Cloud Vision API（伺服器端使用，只有 FastAPI 讀取，前端不會、
# 也不該引用；沒有 VITE_ 前綴是刻意的，避免被誤會成要打包進前端 bundle）
# 取得方式：console.cloud.google.com → API 和服務 → 憑證
CLOUD_API_KEY=
CLOUD_API_URL=https://vision.googleapis.com/v1/images:annotate?key=

# ── Cloudinary（頭像與筆記圖片上傳）─────────────────────────
# 取得方式：cloudinary.com → Dashboard
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ── GitHub Models API Token（AI 對話功能）────────────────────
# 取得方式：github.com → Settings → Developer Settings → Personal access tokens
# 沒設定不影響其他功能／Django 啟動，只有 AI 對話（/AIModel/tayal_chat、
# review_tayal_chat）這兩個端點會回 503。
GITHUB_TOKEN=

# ── Django 安全金鑰（生產環境請換成隨機長字串）──────────────
# 產生方式：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# ── Django DEBUG 模式（開發環境設 True，生產環境務必留空或設 False）
# 只控制錯誤訊息詳細度、SQL echo 這類「除錯資訊」，不影響是否驗證身份
# （身份驗證改由下面的 AUTH_DEV_BYPASS 獨立控制，避免正式環境誤設 DEBUG=True
# 就連帶讓全站認證失效）。
# 名稱雖然叫 DJANGO_DEBUG，但 FastAPI（backend/fastAPI/）也會讀這個變數
# （AUTH_DEV_BYPASS 互鎖判斷、Sentry 環境預設值），兩個服務共用同一份根目錄
# .env——只看 FastAPI 那一側的人容易誤以為這個變數跟自己無關，其實有關。
DJANGO_DEBUG=False

# ── 是否略過 Firebase token 驗證（僅限本機開發）────────────────
# True  = 略過驗證（不需要設定 FIREBASE_SERVICE_ACCOUNT_PATH 也能跑）
# False 或留空 = 啟用 token 驗證（正式部署請使用；即使誤設也不影響，因為
#                 下面還要求 DJANGO_DEBUG 也必須是 True 才會真的略過驗證）
# 本機開發若沒有 Firebase 服務帳戶金鑰，可設為 True 搭配 DJANGO_DEBUG=True。
AUTH_DEV_BYPASS=True

# 選填：只想繞過 FastAPI 的驗證、Django 仍要求真實 token（或反過來只設定這個
# 而讓上面的 AUTH_DEV_BYPASS 對 Django 生效）時才需要填，設定時優先於上面的
# AUTH_DEV_BYPASS 生效；沒有設定則兩服務沿用同一份 AUTH_DEV_BYPASS（預設行為）。
# FASTAPI_AUTH_DEV_BYPASS=

# ── Firebase Admin SDK（AI 端點身份驗證，生產環境必填）────────
# 取得方式：Firebase Console → 專案設定 → 服務帳戶 → 產生新的私密金鑰
# 儲存下載的 JSON 檔案後填入路徑（AUTH_DEV_BYPASS 不是 True 時啟用）
FIREBASE_SERVICE_ACCOUNT_PATH=

# ── CORS 允許來源（Django + FastAPI 共用，部署時改為正式 domain）
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Django ALLOWED_HOSTS 額外網域（逗號分隔，部署到 Render 以外的平台時填）
# Render 會自動注入 RENDER_EXTERNAL_HOSTNAME，不需要在這裡重複填。
DJANGO_ALLOWED_HOSTS=

# ── Django CSRF_TRUSTED_ORIGINS（逗號分隔，部署時填正式網域，需含協定）
# 例如：https://your-app.example.com
CSRF_TRUSTED_ORIGINS=

# ── Redis（Django 與 FastAPI 兩個服務的限流計數共用存放位置）
# 沒設定時 Django 退回預設的 LocMemCache、FastAPI（slowapi）退回記憶體計數，
# 都僅單一 process 內有效——正式環境若 gunicorn/uvicorn 開多個 worker，同一個
# 限流門檻會被 worker 數量乘倍放大。部署多 worker 時建議設定，同一個值會同時
# 套用到兩個服務，例如：redis://localhost:6379/0
REDIS_URL=

# ── Sentry（錯誤追蹤／告警，Django 與 FastAPI 共用）───────────
# 沒設定時完全不影響現有行為（不會嘗試連線、不影響啟動）。設定後 ERROR 等級
# 以上的例外會送到 Sentry，容器重啟後本機 log 消失也還查得到記錄，出錯（含
# Google Vision／GitHub Models 等按用量計費的外部服務失敗）也能主動收到通知。
# 取得方式：sentry.io → 建立專案 → Settings → Client Keys (DSN)
SENTRY_DSN=
# 選填：區分是哪個環境送出的事件，預設依 DJANGO_DEBUG 自動判斷 development/production
SENTRY_ENVIRONMENT=
# 選填：效能追蹤取樣率（0~1），預設 0（關閉，只送錯誤事件，不送效能追蹤資料）
SENTRY_TRACES_SAMPLE_RATE=

# ── ffmpeg 路徑（語音比對功能，若系統 PATH 已有 ffmpeg 可省略）
# Windows 範例：FFMPEG_PATH=C:\Program Files\ffmpeg\bin\ffmpeg.exe
# Mac/Linux 範例：FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFMPEG_PATH=
# 選填：ffprobe 路徑。沒設定時會先試 FFMPEG_PATH 同一個資料夾底下的 ffprobe，
# 找不到才退回系統 PATH（見 backend/fastAPI/routes/quiz.py 的 _find_ffprobe）。
# 通常跟 ffmpeg 裝在同一個資料夾，不用另外設定。
# FFPROBE_PATH=

# ── FastAPI 資料庫連線池（backend/fastAPI/routes/connect.py，皆有安全預設值，
# 一般不需調整；流量大或連線逾時異常時才需要調校）
# DB_POOL_SIZE=10
# DB_POOL_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30

# ── 結構化 log 設定（Django 與 FastAPI 共用，見 backend/config/logging.py，
# 皆有安全預設值，一般不需調整）
# LOG_DIR=backend/logs
# LOG_LEVEL=INFO
# 單一 log 檔案大小上限（bytes），超過就 rotate
# LOG_MAX_BYTES=10485760
# 最多保留幾份 rotate 後的舊檔
# LOG_BACKUP_COUNT=5
