rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // sharedNotes 非作者的按讚更新（見下方 update 規則）：原本只檢查改動的
    // 欄位只有 likes/likedBy，沒有驗證兩者是否一致、也沒有限制 likedBy 只能
    // 新增／移除呼叫者自己的 uid。任何登入使用者原本可以把 likes 設成任意
    // 數字、把別人的 uid 塞進 likedBy（偽造別人按讚）或清空別人的讚——
    // noteshare.jsx 的 toggleLike 在本地算好新值才寫入，但 Firestore 規則
    // 才是真正的信任邊界。這裡驗證：(1) likes 必須等於 likedBy 的「不重複」
    // 筆數，(2) 新舊 likedBy 唯一的差異只能是呼叫者自己的 uid（用對稱差集
    // toSet().difference()/union() 表示，同時涵蓋新增讚與取消讚兩種情況）。
    //
    // likes 對照 likedBy.size() 而不是 newSet.size()：toSet() 會把重複值
    // 去重，但驗證 likes 這一步原本是拿「還沒去重的原始 list」的 .size() 來
    // 比對——呼叫者可以把自己的 uid 在 likedBy 裡重複塞很多次（例如
    // ['bob','bob']），changedUids 用 set 運算後只看到一個 bob（符合
    // [uid].toSet()），但 likes 卻能對到未去重的筆數（2），一次 update 就把
    // likes 灌成任意數字（獨立審查覆核這批修正時找到的問題）。加一條
    // 「原始 list 長度必須等於去重後的 set 長度」，杜絕 likedBy 帶重複值。
    function isValidLikeToggle(oldData, newData, uid) {
      let oldSet = oldData.likedBy.toSet();
      let newSet = newData.likedBy.toSet();
      let changedUids = oldSet.difference(newSet).union(newSet.difference(oldSet));
      return newData.likedBy is list
        && newData.likedBy.size() == newSet.size()
        && newData.likes is int
        && newData.likes == newData.likedBy.size()
        && changedUids == [uid].toSet();
    }

    // 後台角色透過 Firebase custom claims 寫入 ID token（見規劃文件 §1.1），
    // 這裡直接讀 request.auth.token.role，不用 get() 額外讀一份 Firestore
    // 文件——每次規則判斷都省一次計費讀取與延遲。isStaff() 是「能不能看到後台」，
    // isAdmin() 是「能不能管理別人的帳號」（僅 owner／admin，見規劃文件 §1.2
    // 權限矩陣），兩者刻意分開，不要把「登入後台」跟「管理帳號」混成同一個判斷。
    function isStaff() {
      return request.auth != null &&
        request.auth.token.role in ['owner', 'admin', 'editor', 'reviewer', 'analyst'];
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.role in ['owner', 'admin'];
    }

    // 使用者資料：本人可讀寫；staff 角色可讀（後台「使用者帳號」列表/詳情要查
    // 學習者資料），但寫入仍然只限本人——停權、改角色這類真正的管理動作都
    // 透過後端 Admin SDK 進行（會繞過這份規則），不開放 staff 直接用前端 SDK
    // 改寫別人的 Firestore 文件，避免多一個攻擊面。
    //
    // 寫入限制（S-07）：本人原本可以整份覆寫，包括 email、joinDate 與任意垃圾欄位（也能塞到 1 MiB 上限，
    // 拖慢後端每次讀學習資料）。現在拆成 create／update，各自限制可寫的欄位、型別與大小；不開放刪除
    // （帳號刪除走後端 Admin SDK，會繞過這份規則）。email 與 joinDate 建立後不可改。
    // 限制的是「這次改動到的欄位」，不是整份文件，所以舊文件裡有不合規的舊值也不影響其他欄位的更新。
    // 規則無法逐一檢查 map／list 裡的每個元素，只能限制型別與筆數；user_errors 與 quiz_model 的內容
    // 由後端讀取時再清理（AIModel/learner_profile.py 只取固定欄位、截斷並過濾控制字元）。
    function validFavorite(fav) {
      return fav is map
        && fav.keys().hasOnly(['id', 'title', 'content'])
        && fav.title is string && fav.title.size() <= 50
        && fav.content is list && fav.content.size() <= 1000;
    }
    function validFavorites(favorites) {
      return favorites is list && favorites.size() <= 10
        && (favorites.size() < 1 || validFavorite(favorites[0]))
        && (favorites.size() < 2 || validFavorite(favorites[1]))
        && (favorites.size() < 3 || validFavorite(favorites[2]))
        && (favorites.size() < 4 || validFavorite(favorites[3]))
        && (favorites.size() < 5 || validFavorite(favorites[4]))
        && (favorites.size() < 6 || validFavorite(favorites[5]))
        && (favorites.size() < 7 || validFavorite(favorites[6]))
        && (favorites.size() < 8 || validFavorite(favorites[7]))
        && (favorites.size() < 9 || validFavorite(favorites[8]))
        && (favorites.size() < 10 || validFavorite(favorites[9]));
    }
    // fields：這次要檢查的欄位名稱（建立時是整份文件的欄位，更新時只是被改動的欄位）
    function userFieldsValid(data, fields) {
      return (!('name' in fields) || (data.name is string && data.name.size() >= 1 && data.name.size() <= 100))
        && (!('identity' in fields) || (data.identity is string && data.identity.size() <= 100))
        && (!('joinDate' in fields) || (data.joinDate is string && data.joinDate.size() <= 40))
        && (!('avatarUrl' in fields) || data.avatarUrl == null
            || (data.avatarUrl is string && data.avatarUrl.size() <= 8192))
        && (!('favorites' in fields) || validFavorites(data.favorites))
        && (!('user_errors' in fields) || (data.user_errors is map && data.user_errors.size() <= 2000))
        && (!('quiz_model' in fields) || (data.quiz_model is map && data.quiz_model.size() <= 30));
    }
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isStaff());
      // email 比對轉小寫：Firebase 的 token 裡 email 是小寫，使用者註冊時打的大小寫不一定
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'identity', 'favorites', 'user_errors', 'joinDate', 'avatarUrl'])
        && request.resource.data.keys().hasAll(['name', 'email', 'identity', 'favorites', 'user_errors', 'joinDate'])
        && request.auth.token.email is string
        && request.resource.data.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && userFieldsValid(request.resource.data, request.resource.data.keys());
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'identity', 'avatarUrl', 'favorites', 'user_errors', 'quiz_model'])
        && userFieldsValid(request.resource.data, request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if false;
    }

    // 詞素學習的規則熟練度狀態（backend/fastAPI/routes/quiz/rule_state_store.py）：只有本人可讀，
    // 前端完全不能寫。狀態由後端用 Admin SDK 在交易裡更新（Admin SDK 會繞過這份規則）；
    // 不開放前端寫入，使用者才無法自己改熟練度、也不會因為多分頁互相覆蓋。
    // 刻意不開放 staff 讀取：這是個人學習資料，後台沒有需要。
    match /users/{userId}/quizRuleState/{tribe} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // 雲端筆記（D-1）：每一頁一份文件，存在 users/{uid}/notes/{noteId}，noteId 沿用本機
    // 筆記的 UUID（useNotePages.js 的 createEmptyNote），之後本機資料遷移時可以一對一對應。
    // 只有本人可讀寫；刻意不開放 staff——這是個人筆記，只有使用者按下「分享」之後
    // 才會另外複製一份到 sharedNotes，後台審核看的是那一份。
    // 注意：上方 users/{userId} 的規則只管那一份文件本身，不會套用到子集合，所以
    // 後台讀得到使用者資料，並不代表讀得到筆記。
    //
    // 限制：標題 100 字元、單頁內容 100,000 字元、每人 200 頁。
    // - 規則語言只能數字元，沒辦法量位元組；100,000 字元是擋住異常寫入的後盾
    //   （Firestore 單一文件上限 1 MiB 也會再擋一次），真正的「單頁 100 KB」位元組
    //   檢查由 D-2 的同步程式在寫入前做。
    // - 規則也不能數一個集合裡有幾份文件，所以頁數用 noteIndex/summary 這份計數文件
    //   記錄，並且把「計數跟實際頁數一致」也交給規則保證：新增或刪除一頁必須和計數
    //   ±1 在同一個批次（writeBatch／transaction）裡一起寫，而且計數文件自己的規則會
    //   去核對 lastId 這一頁確實在這個批次裡被建立／刪除。因此計數不能憑空改動，
    //   也不能一次新增兩頁只加一，200 頁的上限才擋得住。
    function noteDocPath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/notes/$(id);
    }
    function noteIndexPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/noteIndex/summary;
    }
    function noteIndexCountBefore(uid) {
      return exists(noteIndexPath(uid)) ? get(noteIndexPath(uid)).data.count : 0;
    }
    function isValidCloudNote(data) {
      return data.keys().hasOnly(['title', 'content', 'createdAt', 'updatedAt', 'editedAt'])
        && data.keys().hasAll(['title', 'content', 'createdAt', 'updatedAt', 'editedAt'])
        && data.title is string && data.title.size() <= 100
        && data.content is string && data.content.size() <= 100000
        // editedAt 是使用者在裝置上實際編輯的時間（毫秒），離線編輯時 updatedAt 會是
        // 補送當下的伺服器時間，兩者不同；多裝置衝突要比的是 editedAt（見 D-2）。
        // 上限是伺服器時間再加一天：容許裝置時鐘稍微不準，但擋掉把 editedAt 設成
        // 遙遠未來、讓之後所有裝置的衝突比較永遠輸掉的寫法。
        && data.editedAt is int && data.editedAt > 0
        && data.editedAt <= request.time.toMillis() + 86400000
        && data.updatedAt == request.time;
    }

    match /users/{userId}/notes/{noteId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && noteId.matches('[A-Za-z0-9_-]{1,128}')
        && isValidCloudNote(request.resource.data)
        && request.resource.data.createdAt == request.time
        && getAfter(noteIndexPath(userId)).data.count == noteIndexCountBefore(userId) + 1
        && getAfter(noteIndexPath(userId)).data.lastOp == 'create'
        && getAfter(noteIndexPath(userId)).data.lastId == noteId;
      // createdAt 不在可改清單裡，所以建立時間改不了；content／title 超過上限的更新
      // 也會因為 isValidCloudNote 而被擋下。
      // editedAt 只能前進（>=）：離線的舊裝置晚一步送出較舊的版本時，不能蓋掉雲端較新的內容。
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'content', 'updatedAt', 'editedAt'])
        && isValidCloudNote(request.resource.data)
        && request.resource.data.editedAt >= resource.data.editedAt;
      allow delete: if request.auth != null && request.auth.uid == userId
        && getAfter(noteIndexPath(userId)).data.count == get(noteIndexPath(userId)).data.count - 1
        && getAfter(noteIndexPath(userId)).data.lastOp == 'delete'
        && getAfter(noteIndexPath(userId)).data.lastId == noteId;
    }

    // 頁數計數文件：固定只有 summary 這一份。欄位 count（目前頁數）、lastOp（最後一次
    // 是 create 或 delete）、lastId（那一頁的 id），三者配合上面 notes 的規則使用。
    // 不開放刪除（帳號刪除由後端 Admin SDK 處理，會繞過規則）。
    match /users/{userId}/noteIndex/summary {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['count', 'lastOp', 'lastId', 'updatedAt'])
        && request.resource.data.keys().hasAll(['count', 'lastOp', 'lastId', 'updatedAt'])
        && request.resource.data.count is int
        && request.resource.data.count == 1
        && request.resource.data.lastOp == 'create'
        && request.resource.data.lastId is string
        && request.resource.data.lastId.matches('[A-Za-z0-9_-]{1,128}')
        && request.resource.data.updatedAt == request.time
        && !exists(noteDocPath(userId, request.resource.data.lastId))
        && existsAfter(noteDocPath(userId, request.resource.data.lastId));
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['count', 'lastOp', 'lastId', 'updatedAt'])
        && request.resource.data.keys().hasAll(['count', 'lastOp', 'lastId', 'updatedAt'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0 && request.resource.data.count <= 200
        && request.resource.data.lastId is string
        && request.resource.data.lastId.matches('[A-Za-z0-9_-]{1,128}')
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.count == resource.data.count + 1
            && request.resource.data.lastOp == 'create'
            && !exists(noteDocPath(userId, request.resource.data.lastId))
            && existsAfter(noteDocPath(userId, request.resource.data.lastId))
          ) || (
            request.resource.data.count == resource.data.count - 1
            && request.resource.data.lastOp == 'delete'
            && exists(noteDocPath(userId, request.resource.data.lastId))
            && !existsAfter(noteDocPath(userId, request.resource.data.lastId))
          )
        );
      allow delete: if false;
    }

    // 測驗題目：登入者可讀；前端不能建立、修改或刪除。
    // 原本登入者可以自己建立（限制內容形狀），但規則無法限制「建立幾份」，任何登入者都能無限建立文件。
    // 現在題目由伺服器在出題時用 Admin SDK 寫入（backend/crawler/quiz_store.py，會繞過這份規則，
    // 並有每人每日份數上限），出題 API 回傳 quizId 給前端寫進 situations。
    // 文件裡的 data 不含正確答案（寫入前已去除，正確答案只存在本人才能讀的 situations），所以讀取維持
    // 「登入者可讀」；舊文件沒有 userId 欄位，不能改成只有擁有者可讀，否則歷史紀錄會打不開。
    match /quizs/{quizId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 答題情形：只有本人可讀；只有本人可建立
    match /situations/{situationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // answeredAt 必須是伺服器時間：每週學習摘要（#25）用它判斷「本週有沒有作答」，不能讓客戶端寫成未來時間
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid
        && request.resource.data.answeredAt == request.time;
    }

    // 使用者學習統計：本人可讀自己的資料；globalAverages 所有登入者可讀；只由後端寫入
    match /userSituation/{docId} {
      allow read: if request.auth != null &&
                     (docId == "globalAverages" || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // 個人行事曆：只有本人可讀寫
    match /calendar/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 追蹤中的讀書計畫（路線圖 #26）：users/{uid}/studyPlans/current，每人同時只有這一份，新的取代舊的。
    // 本人可讀寫（勾選完成、套用重排都由前端寫）；刻意不開放 staff，這是個人學習資料。
    // 規則語言沒有迴圈，所以任務最多 14 筆就用固定位置逐一檢查（areValidStudyTasks／isValidStudyTask）：
    // 必須是物件、欄位最多 7 個（6 個必要欄位加一個選填的 calendarEventId）、必要欄位存在且長度在上限內
    // （缺欄位或型別沒有 size() 時存取會直接讓規則失敗，等於拒絕）、done 必須是布林。
    // 每次請求最多只能評估 1000 個運算式：14 筆任務若逐項做完整檢查（hasOnly／hasAll、is string、
    // 非空、calendarEventId 內容）會超過上限（模擬器實測），所以這裡刻意精簡，把「擋住大型垃圾資料」放在規則，
    // 其餘交給後端 clean_plan（不合法的任務丟掉）：空字串、欄位型別（例如 summary 是不是字串）、
    // id 不重複、start／end 的時間格式與先後，以及 calendarEventId 的內容（後端不使用它）。
    function isValidStudyTask(task) {
      return task is map
        && task.keys().size() <= 7
        && task.id.size() <= 64
        && task.summary.size() <= 100
        && task.description.size() <= 300
        && task.start.size() <= 40
        && task.end.size() <= 40
        && task.done is bool;
    }

    function isValidStudyPlan(data) {
      return data.keys().hasOnly(['title', 'tasks', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['title', 'tasks', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.tasks is list && data.tasks.size() >= 1 && data.tasks.size() <= 14
        && data.updatedAt == request.time
        && areValidStudyTasks(data.tasks);
    }

    function areValidStudyTasks(tasks) {
      let n = tasks.size();
      return true
        && (n <= 0 || isValidStudyTask(tasks[0]))
        && (n <= 1 || isValidStudyTask(tasks[1]))
        && (n <= 2 || isValidStudyTask(tasks[2]))
        && (n <= 3 || isValidStudyTask(tasks[3]))
        && (n <= 4 || isValidStudyTask(tasks[4]))
        && (n <= 5 || isValidStudyTask(tasks[5]))
        && (n <= 6 || isValidStudyTask(tasks[6]))
        && (n <= 7 || isValidStudyTask(tasks[7]))
        && (n <= 8 || isValidStudyTask(tasks[8]))
        && (n <= 9 || isValidStudyTask(tasks[9]))
        && (n <= 10 || isValidStudyTask(tasks[10]))
        && (n <= 11 || isValidStudyTask(tasks[11]))
        && (n <= 12 || isValidStudyTask(tasks[12]))
        && (n <= 13 || isValidStudyTask(tasks[13]));
    }

    match /users/{userId}/studyPlans/{planId} {
      allow read: if request.auth != null && request.auth.uid == userId && planId == 'current';
      allow create: if request.auth != null && request.auth.uid == userId && planId == 'current'
        && isValidStudyPlan(request.resource.data)
        && request.resource.data.createdAt == request.time;
      // createdAt 建立後不能改
      allow update: if request.auth != null && request.auth.uid == userId && planId == 'current'
        && isValidStudyPlan(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && request.auth.uid == userId && planId == 'current';
    }

    // 每週學習摘要（路線圖 #25）：users/{uid}/weeklyDigest/current，只有後端排程（Admin SDK）能建立與改寫內容。
    // 本人可以讀，並且只能把 dismissedAt 設成現在（關閉這張卡片）或清回 null（重新顯示）；摘要、統計、複習詞
    // 都不能自己改。不開放 staff，這是個人學習資料。
    match /users/{userId}/weeklyDigest/{digestId} {
      allow read: if request.auth != null && request.auth.uid == userId && digestId == 'current';
      allow create, delete: if false;
      allow update: if request.auth != null && request.auth.uid == userId && digestId == 'current'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissedAt'])
        && (request.resource.data.dismissedAt == request.time || request.resource.data.dismissedAt == null);
    }

    // 發音錄音：登入者可讀；登入者只能建立 uid 為本人的錄音；staff 可刪除
    // （內容審核「移除」動作，見規劃文件 §3.7.2）——本人原本就不能刪自己的
    // 錄音（沒有這條規則以前 delete 完全沒開放），這裡刻意只開放給 staff，
    // 不順便放開自我刪除，維持原本行為不變。
    // create 原本只驗證 uid 是本人，storageUrl 完全沒有限制——後端刪除
    // 錄音（審核下架／帳號刪除）時會直接依 storageUrl 去刪 Storage 物件，
    // 沒有限制的話，惡意使用者可以建立一筆帶偽造 storageUrl（指向同一個
    // bucket 裡任何其他物件）的錄音，誘使之後的刪除流程刪掉不相關的檔案。
    // 這裡強制 storageUrl 必須是真正的 Firebase Storage 下載網址，且物件
    // 路徑落在跟這筆文件所屬 tribe 一致的 `pronunciations/{tribe}/` 底下
    // （跟後端 delete_storage_file_by_download_url() 的 expected_path_prefix
    // 檢查是同一道防線的兩端）；其餘欄位型別也一併驗證，比照 quizs 集合的
    // 既有慣例。
    match /pronunciations/{tribe}/recordings/{recordingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && tribe in ['tayal', 'amis', 'bunun', 'kavalan', 'paiwan']
        && request.resource.data.tribe == tribe
        && request.resource.data.word is string
        && request.resource.data.word.size() > 0 && request.resource.data.word.size() <= 100
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 100
        && request.resource.data.storageUrl is string
        && request.resource.data.storageUrl
          .matches('https://firebasestorage\\.googleapis\\.com/v0/b/[^/]+/o/pronunciations%2F' + tribe + '%2F.*')
        && request.resource.data.createdAt == request.time;
      allow delete: if isStaff();
    }

    // 共享筆記：任何人（含未登入）可讀，配合 /share/:id 這條公開分享連結路由
    // （見 route.jsx，該路由沒有包 ProtectedRoute）；登入者可建立；作者只能更新
    // pages/preview/image 這幾個內容欄位（見下方 update 規則），非作者的登入者
    // 只能更新 likes/likedBy（按讚，見 noteshare.jsx toggleLike）；作者可刪除。
    // 刪除是軟刪除（noteshare.jsx 的 handleModalDelete 只是 updateDoc 把 deleted
    // 設成 true，文件並未真的移除），列表查詢都有帶 where("deleted","==",false)
    // 過濾，但原本這裡的 read 規則沒有擋，直接用文件 ID 讀取（/share/:id 分享連結）
    // 仍能打開已刪除的筆記。用 .get('deleted', false) 而非直接比對欄位，讓這個
    // 軟刪除功能上線之前建立、沒有 deleted 欄位的舊文件預設視為未刪除，不會被
    // 這條新規則擋掉。
    match /sharedNotes/{noteId} {
      // staff 額外可讀已下架的筆記——審核佇列跟「查看已下架內容」都需要看得到
      // deleted=true 的文件，一般使用者／未登入訪客則維持原本規則（下架後
      // /share/:id 連結就打不開）。
      allow read: if resource.data.get('deleted', false) == false || isStaff();
      // 原本只檢查有沒有登入，任何登入使用者都能建立一筆冒充別人 uid 的筆記——
      // 而 update／delete 規則（見下方）又是直接信任這個可被偽造的 uid 欄位。
      // 比照同檔案 situations／pronunciations 的作法，要求寫入的 uid 就是本人。
      // 同一批修復替 quizs 加了必填欄位檢查與內容長度上限，這裡原本沒有套用，
      // 補上型別、長度、初始狀態（讚數／讚清單／deleted 都必須是剛建立時的值，
      // 不能一開始就偽造已經有讚或已經被標成刪除）與 createdAt 防偽造。
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['pages', 'preview', 'uid', 'username', 'createdAt', 'likes', 'likedBy', 'deleted'])
        && request.resource.data.pages is list
        && request.resource.data.pages.size() > 0 && request.resource.data.pages.size() <= 50
        && request.resource.data.preview is string
        && request.resource.data.preview.size() <= 5000
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0 && request.resource.data.username.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.likes == 0
        && request.resource.data.likedBy is list && request.resource.data.likedBy.size() == 0
        && request.resource.data.deleted == false;
      // update 拆成三種互斥能力，各自只能動自己該動的欄位——原本作者分支是
      // `resource.data.uid == request.auth.uid` 沒有任何 affectedKeys() 限制，
      // 等於作者可以改任意欄位，包含把 staff 剛下架的 deleted:true 自己改回
      // false（繞過整個審核機制）、把 likes 改成任意數字（排行造假）、把
      // uid/username 改成別人（將違規內容歸屬轉嫁給無辜使用者）。也因為
      // update 完全沒有重新套用 create 的欄位/長度驗證，一次 update 就能繞過
      // pages.size()<=50、preview.size()<=5000 這些限制（獨立審查找到的問題）。
      //
      // 作者現在只能改 pages/preview/image 這幾個內容欄位，且改動後仍要符合
      // create 當初的形狀驗證；uid/createdAt/username/likes/likedBy/deleted
      // 對作者分支而言不在 hasOnly() 白名單內，任何一個被夾帶改動就會被擋下，
      // 不需要另外重複比對「這些欄位沒有變」。
      //
      // 作者分支與按讚分支都額外要求「目前不是下架狀態」——下架代表內容被
      // staff 凍結：作者不能在下架期間偷改內容（不然 staff 之後恢復時，
      // 恢復的已經不是當初審核／下架當下看到的那份內容），其他登入者也不該
      // 對一則已下架的筆記按讚（獨立審查覆核這批修正時找到的問題，跟原本
      // 「作者不能把 deleted 改回 false」是同一種「下架=凍結」精神，只是這裡
      // 補齊「凍結」也包含內容本身跟讚數，不是只擋 deleted 欄位）。
      allow update: if request.auth != null && (
        (
          resource.data.uid == request.auth.uid &&
          resource.data.get('deleted', false) == false &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pages', 'preview', 'image']) &&
          request.resource.data.pages is list &&
          request.resource.data.pages.size() > 0 && request.resource.data.pages.size() <= 50 &&
          request.resource.data.preview is string &&
          request.resource.data.preview.size() <= 5000 &&
          // image 在 create 規則裡本來就是選填（noteService.jsx 的 shareNote()
          // 一律寫入 image:''，但在這條規則加入之前建立的舊文件可能完全沒有
          // 這個欄位）——用 .get(key, default) 而非直接存取，沒有這個欄位時
          // 安全地當成空字串通過型別檢查，不會讓規則對缺欄位的舊資料直接噴
          // evaluation error（獨立審查跑 emulator 測試時實際抓到的迴歸）。
          request.resource.data.get('image', '') is string
        ) ||
        (
          // 排除作者：noteshare.jsx 的 toggleLike 本來就禁止對自己的筆記按讚
          // （isMine(note) return），這裡讓規則跟前端的實際用法一致，同時
          // 也讓「作者能做什麼」與「其他登入者能做什麼」維持真正互斥、不重疊。
          resource.data.uid != request.auth.uid &&
          resource.data.get('deleted', false) == false &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']) &&
          isValidLikeToggle(resource.data, request.resource.data, request.auth.uid)
        ) ||
        (
          // staff 下架／恢復：只能動 deleted 這個欄位，且必須是布林值——不能
          // 連帶改內文、讚數這些跟審核無關的欄位，也不能寫入非布林值（例如
          // 字串／null／數字）意外讓 read 規則的 `deleted==false` 判斷失準，
          // 使文件永久對一般使用者隱藏或污染後台查詢（獨立審查找到的問題）。
          // 把「作者能改什麼」跟「staff 能改什麼」的權限範圍徹底分開，即使
          // staff 帳號被盜也頂多能下架/恢復內容，改不了內容本身。
          isStaff() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted']) &&
          request.resource.data.deleted is bool
        )
      );
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 檢舉：任何登入使用者可對 note／recording 建立自己名下的檢舉（targetTribe
    // 對 note 是空字串，recording 必填，因為錄音存在 pronunciations/{tribe}/
    // recordings/{id} 子集合，只有 targetId 定位不到文件，見規劃文件 P3.6）；
    // 只有 staff 可讀（檢舉人自己也看不到檢舉列表，避免報復性騷擾）；
    // staff 核結/駁回只能動狀態相關欄位，不能竄改原始檢舉內容本身。
    match /reports/{reportId} {
      allow read: if isStaff();
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        // hasOnly（不是 hasAll）：不能夾帶這 8 個欄位以外的任何東西進來，
        // 避免有心人塞一堆大型垃圾欄位增加 Firestore 儲存/讀取成本。
        && request.resource.data.keys().hasOnly(
          ['targetType', 'targetId', 'targetTribe', 'reporterUid', 'reason', 'reasonText', 'status', 'createdAt']
        )
        && request.resource.data.targetType in ['note', 'recording']
        && request.resource.data.targetId is string && request.resource.data.targetId.size() > 0
        // targetTribe 依 targetType 硬性規定：note 一定是空字串、recording
        // 一定要落在真實族語清單內——否則後台永遠定位不到那筆 recording
        // 文件（見 pronunciations/{tribe}/recordings/{id} 的路徑結構），
        // 這筆檢舉就會卡在「內容已不存在」永遠沒辦法處理。
        && (
          (request.resource.data.targetType == 'note' && request.resource.data.targetTribe == '')
          || (
            request.resource.data.targetType == 'recording'
            && request.resource.data.targetTribe in ['tayal', 'amis', 'bunun', 'kavalan', 'paiwan']
          )
        )
        && request.resource.data.reason in ['inappropriate', 'wrong_content', 'spam', 'other']
        && request.resource.data.reasonText is string && request.resource.data.reasonText.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['status', 'resolvedBy', 'resolvedAt', 'resolutionNote']
        )
        && request.resource.data.status in ['resolved', 'dismissed'];
      allow delete: if false;
    }

    // 其他所有文件：預設拒絕，避免未知集合被誤開放
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
