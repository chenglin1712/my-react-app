rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 使用者資料：只有本人可讀寫
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 測驗題目：登入者可讀；登入者可建立，且限制內容形狀——原本只檢查有沒有
    // 登入，任何已登入使用者都能寫入任意垃圾文件。uploadDb.jsx 的
    // uploadQuizDB 固定寫入 title/tribe/createdAt/data 四個欄位，這裡驗證
    // 型別、族語限定在已知清單、data 非空且有合理上限，createdAt 必須是
    // 真正的伺服器時間（擋掉客戶端偽造時間戳記）。
    match /quizs/{quizId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['title', 'tribe', 'createdAt', 'data'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.tribe in ['tayal', 'amis', 'bunun', 'kavalan', 'paiwan']
        && request.resource.data.createdAt == request.time
        && request.resource.data.data is list
        && request.resource.data.data.size() > 0 && request.resource.data.data.size() <= 200;
    }

    // 答題情形：只有本人可讀；只有本人可建立
    match /situations/{situationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // 使用者學習統計：本人可讀自己的資料；globalAverages 所有登入者可讀；只由後端寫入
    match /userSituation/{docId} {
      allow read: if request.auth != null &&
                     (docId == "globalAverages" || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // 個人行事曆：只有本人可讀寫
    match /calendar/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 發音錄音：登入者可讀；登入者只能建立 uid 為本人的錄音
    match /pronunciations/{tribe}/recordings/{recordingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // 共享筆記：任何人（含未登入）可讀，配合 /share/:id 這條公開分享連結路由
    // （見 route.jsx，該路由沒有包 ProtectedRoute）；登入者可建立；作者可更新任何欄位
    // （編輯筆記內容），非作者的登入者只能更新 likes/likedBy（按讚，見 noteshare.jsx
    // toggleLike）；作者可刪除。
    // 刪除是軟刪除（noteshare.jsx 的 handleModalDelete 只是 updateDoc 把 deleted
    // 設成 true，文件並未真的移除），列表查詢都有帶 where("deleted","==",false)
    // 過濾，但原本這裡的 read 規則沒有擋，直接用文件 ID 讀取（/share/:id 分享連結）
    // 仍能打開已刪除的筆記。用 .get('deleted', false) 而非直接比對欄位，讓這個
    // 軟刪除功能上線之前建立、沒有 deleted 欄位的舊文件預設視為未刪除，不會被
    // 這條新規則擋掉。
    match /sharedNotes/{noteId} {
      allow read: if resource.data.get('deleted', false) == false;
      // 原本只檢查有沒有登入，任何登入使用者都能建立一筆冒充別人 uid 的筆記——
      // 而 update／delete 規則（見下方）又是直接信任這個可被偽造的 uid 欄位。
      // 比照同檔案 situations／pronunciations 的作法，要求寫入的 uid 就是本人。
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])
      );
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 其他所有文件：預設拒絕，避免未知集合被誤開放
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
